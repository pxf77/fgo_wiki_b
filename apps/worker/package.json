{
  "name": "@fgo-wiki/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts snapshot",
    "start": "node dist/index.js",
    "snapshot": "tsx src/index.ts snapshot",
    "sync:atlas": "tsx src/index.ts sync-atlas",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@fgo-wiki/domain": "workspace:*"
  }
}
