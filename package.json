{
  "name": "fgo-cn-meta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "dev": "pnpm build:packages && turbo run dev --parallel",
    "dev:web": "pnpm build:packages && turbo run dev --filter=@fgo-wiki/web",
    "dev:api": "pnpm build:packages && turbo run dev --filter=@fgo-wiki/api",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "snapshot:build": "pnpm --filter @fgo-wiki/worker snapshot",
    "db:generate": "pnpm --filter @fgo-wiki/database db:generate",
    "db:migrate": "pnpm --filter @fgo-wiki/database db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
