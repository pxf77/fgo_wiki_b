{
  "name": "fgo-cn-meta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter='./packages/*'",
    "dev": "pnpm build:packages && turbo run dev --parallel",
    "dev:web": "pnpm build:packages && turbo run dev --filter=@fgo-wiki/web",
    "dev:api": "pnpm build:packages && turbo run dev --filter=@fgo-wiki/api",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:sync:atlas": "pnpm build:packages && pnpm --filter @fgo-wiki/worker sync:atlas",
    "data:prepare": "pnpm build:packages && pnpm --filter @fgo-wiki/worker data:prepare",
    "data:prepare:fixture": "pnpm build:packages && pnpm --filter @fgo-wiki/worker data:prepare:fixture",
    "data:catalog": "pnpm build:packages && pnpm --filter @fgo-wiki/worker catalog:cn",
    "data:verify": "pnpm data:prepare:fixture && pnpm snapshot:build",
    "snapshot:build": "pnpm build:packages && pnpm --filter @fgo-wiki/worker snapshot",
    "version:check": "tsx apps/worker/src/pr-version-contract.ts",
    "db:generate": "pnpm --filter @fgo-wiki/database db:generate",
    "db:migrate": "pnpm --filter @fgo-wiki/database db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3"
  }
}
